package basic

import ui.theme.Color
import ui.theme.Theme
import ui.theme.ThemeDefinition
import ui.theme.ThemeManager
import ui.theme.ThemeMode
import ui.theme.ThemeOverride
import ui.theme.ThemeSource
import ui.theme.Tone
import ui.theme.Appearance

Void main() {
  var manager = ThemeManager(ThemeDefinition(primary: Color(hex: "#B2DBEB")))
  var sidebar = manager.scope(ThemeOverride(mode: ThemeMode.Dark))
  ThemeSource source = manager
  var subscription = source.watch((Theme theme) {
    var colors = theme.control(tone: Tone.Primary, appearance: Appearance.Filled)
    printLine(colors.normal.background.hex())
  })
  try {
    manager.setMode(ThemeMode.Dark)
    manager.configure(
      definition: ThemeDefinition(primary: Color(hex: "#6750A4")),
      mode: ThemeMode.Light
    )
    require(condition: sidebar.current().mode == ThemeMode.Dark, message: "local mode remains dark")
  } finally {
    manager.close()
  }
}
